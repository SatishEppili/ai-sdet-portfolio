{
  "name": "ai-sdet-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered test automation portfolio: self-healing locators, AI failure triage, LLM evaluation, AI red-teaming and agentic exploratory testing.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "llm:ping": "tsx scripts/llm-ping.ts",
    "lab:up": "docker compose -f docker/docker-compose.yml up -d",
    "lab:down": "docker compose -f docker/docker-compose.yml down",
    "toolshop:up": "bash scripts/toolshop-up.sh",
    "toolshop:down": "docker compose -f docker/toolshop.compose.yml down -v"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
